{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri-schema/v2/schema.json",
  "productName": "Savant",
  "version": "0.3.5",
  "identifier": "com.savant.desktop",
  "build": {
    "beforeDevCommand": "node src-tauri/scripts/setup-updater-keys.js && npm --prefix dashboard run dev",
    "beforeBuildCommand": "npm --prefix ../../dashboard run build && node src-tauri/scripts/setup-updater-keys.js",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../../dashboard/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Savant Swarm Dashboard",
        "width": 2560,
        "height": 1440,
        "x": 0,
        "y": 0,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "logs",
        "title": "Savant — Agent Logs",
        "url": "logs.html",
        "width": 1280,
        "height": 800,
        "x": -2560,
        "y": 0,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "browser",
        "title": "Savant — Agent Browser",
        "url": "browser-standalone.html",
        "width": 1280,
        "height": 800,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:* http://localhost:* wss://localhost:* ws://127.0.0.1:* http://127.0.0.1:* wss://127.0.0.1:*; img-src 'self' http://127.0.0.1:* http://localhost:* data:"
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "2026 Savant",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fame0528/Savant/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxMTQyNkFDMzE3RTc4NjAKUldSZ2VINHhyQ1lVUVUzNVB6eFJrcitJTTRBZlJtK2pJdkowS3lFcm5pdEV1Q3J3TnViaExTV0wK"
    }
  }
}
